rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Gallery images: public read (main site), organisers write
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Organiser photos: public read, organisers write
    match /organisers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Payment QR code: public read (shown on contribute page), organisers write
    match /payment/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Decorative assets: public read, organisers write
    match /decorative/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
